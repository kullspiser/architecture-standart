@startuml
!include <C4/C4_Component>
title Передача ставок в кол-центр — диаграмма контекста (объединённый банк)

' === Акторы ===
Person(client, "Клиент банка", "Обращается в кол-центр для уточнения ставок по депозитам")

' === Система ===
System(bankSystem, "Банк (включая внутренний кол-центр)", "Обрабатывает ставки по депозитам, управляет их публикацией для внутренних и внешних кол-центров")

' === Внешние системы ===
System_Ext(partnerCallCenter, "Партнёрский кол-центр", "Консультирует клиентов банка по ставкам через CSV/XLS")

' === Взаимодействия ===
Rel(client, bankSystem, "Звонит для уточнения ставок")
Rel(bankSystem, partnerCallCenter, "Передача актуальных ставок в виде файлов (CSV/XLS)")
Rel(partnerCallCenter, client, "Консультирует по актуальным ставкам")

@enduml